            },
            "scale": {
              "default": 1,
              "type": "integer"
            },
            "slug": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "unit_kind": {
              "enum": [
                "currency",
                "count",
                "percent"
              ],
              "type": "string"
            }
          },
          "required": [
            "slug",
            "name",
            "display_name",
            "unit",
            "unit_kind"
          ],
          "type": "object"
        },
        "latest": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "as_of": {
                  "format": "date",
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "period",
                "as_of",
                "value",
                "unit"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Most recent snapshot (highest as_of)."
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fiscal quarter of the current QTD estimate, e.g. 2026Q1."
        },
        "prior_quarter": {
          "anyOf": [
