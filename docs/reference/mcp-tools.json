  {
    "annotations": {
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "List the KPIs published for one company, with units and the periods covered.\n\nUse it to learn the exact KPI slugs/names for a ticker before asking for history or\nQTD, or when a KPI call failed with `kpi_not_found`. `has_qtd` tells you whether a\ncurrent quarter-to-date estimate exists; `first_period`/`last_period` bound the history.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "ticker": {
          "description": "Ticker symbol, e.g. ORBY. Case-insensitive. Unsure? Call search_companies first.",
          "maxLength": 10,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ticker"
      ],
      "type": "object"
    },
    "name": "list_company_kpis",
    "output_schema": {
      "properties": {
        "company": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "sector": {
              "type": "string"
            },
            "ticker": {
              "type": "string"
            }
          },
          "required": [
            "ticker",
            "name",
            "sector"
          ],
          "type": "object"
        },
        "kpis": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "default": "",
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "first_period": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "has_qtd": {
                "default": false,
                "type": "boolean"
              },
              "historical_count": {
                "default": 0,
                "type": "integer"
              },
              "last_period": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "latest_qtd_as_of": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "name": {
                "type": "string"
              },
              "scale": {
                "default": 1,
                "type": "integer"
              },
              "slug": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "unit_kind": {
                "enum": [
                  "currency",
                  "count",
                  "percent"
                ],
                "type": "string"
              }
            },
            "required": [
              "slug",
              "name",
              "display_name",
              "unit",
              "unit_kind"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "trace_id": {
          "description": "Correlation id; quote it when reporting a problem.",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "company",
        "kpis"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Find companies by ticker, partial name or sector, or discover what exists.\n\nUse this first whenever you are not sure of a ticker. Call it with no arguments to list\nevery company and every sector. An empty result is not an error: it includes\n`suggestions` (closest tickers) so you can retry with `suggestions[0].value`.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "description": "Maximum companies to return.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ticker or part of a company name, e.g. 'ORBY' or 'analytics'. Omit to list every company."
        },
        "sector": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict to one sector, e.g. 'Software'. Case-insensitive."
        }
      },
      "type": "object"
    },
    "name": "search_companies",
    "output_schema": {
      "properties": {
        "companies": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "sector": {
                "type": "string"
              },
              "ticker": {
                "type": "string"
              }
            },
            "required": [
              "ticker",
              "name",
              "sector"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sector_filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sectors_available": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "All sector names; present only when called without arguments."
        },
        "suggestions": {
          "description": "Close matches when nothing matched; retry with suggestions[].value.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "score": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label",
              "score"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "total": {
          "type": "integer"
        },
        "trace_id": {
          "description": "Correlation id; quote it when reporting a problem.",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "companies",
        "total"
      ],
      "type": "object"
    }
  }
]
