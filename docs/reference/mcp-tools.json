          "description": "KPI slug as returned by list_company_kpis (e.g. total_revenue, annual_recurring_revenue, customer_churn), its full name, or an everyday alias such as 'revenue', 'ARR', 'NRR' or 'churn'.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "ticker": {
          "description": "Ticker symbol, e.g. ORBY. Case-insensitive. Unsure? Call search_companies first.",
          "maxLength": 10,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "kpi"
      ],
      "type": "object"
    },
