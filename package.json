{
  "name": "kpi-platform-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "KPI Intelligent Platform - JS/TS workspace root",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"tests/e2e/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"tests/e2e/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
