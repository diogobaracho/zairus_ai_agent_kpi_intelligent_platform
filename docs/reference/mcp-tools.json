            },
            "ticker": {
              "type": "string"
            }
          },
          "required": [
            "ticker",
            "name",
            "sector"
          ],
          "type": "object"
        },
        "kpi": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "default": "",
