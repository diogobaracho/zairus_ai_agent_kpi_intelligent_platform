# Copy to .env. Every value below works out of the box with `make up`; nothing is required.

# --- shared (kpi_core) -------------------------------------------------------
KPI_ENV=local                      # local | test | staging | production
KPI_LOG_LEVEL=INFO
KPI_DATABASE_URL=postgresql+asyncpg://kpi:kpi@localhost:5432/kpi
KPI_CORRELATION_HEADER=X-Correlation-Id
KPI_DEFAULT_TENANT_ID=default
KPI_FUZZY_CUTOFF=55                # rapidfuzz score 0..100 below which suggestions are dropped
KPI_FUZZY_LIMIT=5
OTEL_SDK_DISABLED=true             # set to false + OTEL_EXPORTER_OTLP_ENDPOINT to export traces

# --- services/api ------------------------------------------------------------
KPI_API_HOST=0.0.0.0
KPI_API_PORT=8080
KPI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
KPI_RATE_LIMIT_RPS=5
KPI_RATE_LIMIT_BURST=20
KPI_MAX_BODY_BYTES=16384
KPI_MCP_URL=http://localhost:8090/mcp
KPI_MCP_MODE=http                  # http | inprocess (inprocess = single-container deployments/tests)

# --- LLM / agent -------------------------------------------------------------
KPI_LLM_PROVIDER=stub              # stub | anthropic
KPI_LLM_MODEL=claude-opus-5
KPI_LLM_EFFORT=medium              # low | medium | high
KPI_LLM_MAX_TOKENS=8000
KPI_LLM_TIMEOUT_S=60
KPI_LLM_FALLBACKS=off           # off | default (Anthropic server-side refusal fallbacks, beta)
ANTHROPIC_API_KEY=                 # required only when KPI_LLM_PROVIDER=anthropic
KPI_AGENT_MAX_ITERATIONS=8
KPI_AGENT_MAX_PARALLEL_TOOLS=4
KPI_AGENT_TOOL_TIMEOUT_S=10
KPI_AGENT_MAX_WALL_CLOCK_S=60
KPI_AGENT_MAX_MESSAGE_CHARS=4000
KPI_AGENT_HISTORY_WINDOW=20
KPI_AGENT_MAX_RESULT_CHARS=6000

# --- services/mcp ------------------------------------------------------------
KPI_MCP_TRANSPORT=http             # stdio | http
KPI_MCP_HOST=0.0.0.0
KPI_MCP_PORT=8090
KPI_MCP_RATE_LIMIT_RPS=20
KPI_MCP_RATE_LIMIT_BURST=40
KPI_MCP_MAX_HISTORY_POINTS=64

# --- frontends (build-time) --------------------------------------------------
VITE_API_BASE_URL=/api             # chat-web; nginx proxies /api -> services/api
VITE_CHAT_URL=http://localhost:3000   # website "Open the chat" CTA
