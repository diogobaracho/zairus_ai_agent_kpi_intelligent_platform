[
  {
    "annotations": {
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Historical (completed-quarter) estimates for one KPI of one company, oldest first.\n\nUse it for trends, year-over-year comparisons and any question about past quarters.\nDo not use it for the current quarter: that is `get_kpi_qtd`. An empty `points` list with\na `note` means no data in the requested range; `available_range` tells you what exists.\nErrors carry `suggestions` and a `recovery_hint` you should follow once before giving up.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "from_period": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fiscal quarter label in the form YYYYQn, e.g. 2024Q3."
        },
        "kpi": {
          "description": "KPI slug as returned by list_company_kpis (e.g. total_revenue, annual_recurring_revenue, customer_churn), its full name, or an everyday alias such as 'revenue', 'ARR', 'NRR' or 'churn'.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "limit": {
          "default": 64,
          "description": "Maximum quarters to return (oldest first within the range).",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "ticker": {
          "description": "Ticker symbol, e.g. ORBY. Case-insensitive. Unsure? Call search_companies first.",
          "maxLength": 10,
          "minLength": 1,
          "type": "string"
        },
        "to_period": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fiscal quarter label in the form YYYYQn, e.g. 2024Q3."
        }
      },
      "required": [
        "ticker",
        "kpi"
      ],
      "type": "object"
    },
    "name": "get_kpi_history",
    "output_schema": {
      "properties": {
        "available_range": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "from_period": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "to_period": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "company": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "sector": {
              "type": "string"
            },
            "ticker": {
              "type": "string"
            }
          },
          "required": [
            "ticker",
            "name",
            "sector"
          ],
          "type": "object"
        },
        "count": {
          "type": "integer"
        },
        "kpi": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "default": "",
              "type": "string"
            },
            "display_name": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "scale": {
              "default": 1,
              "type": "integer"
            },
            "slug": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "unit_kind": {
              "enum": [
                "currency",
                "count",
                "percent"
              ],
              "type": "string"
            }
          },
          "required": [
            "slug",
            "name",
            "display_name",
            "unit",
            "unit_kind"
          ],
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "points": {
          "description": "Completed quarters, ascending by period.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "period": {
                "type": "string"
              },
              "period_end": {
                "format": "date",
                "type": "string"
              },
              "period_start": {
                "format": "date",
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "period",
              "period_start",
              "period_end",
              "value",
              "unit"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "requested_range": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "from_period": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "to_period": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trace_id": {
          "description": "Correlation id; quote it when reporting a problem.",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "trace_id",
        "company",
        "kpi",
        "points",
        "count"
      ],
      "type": "object"
    }
  },
  {
